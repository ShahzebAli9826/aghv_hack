# Expo App Environment Variables
# Duplicate this file to .env or .env.local

# FastAPI Backend URL (replace with your local IP when running on Expo Go)
EXPO_PUBLIC_API_URL=http://192.168.1.7:8000/api

# E.164 test number for the demo voice-call buttons. Leave empty and those buttons place no call.
EXPO_PUBLIC_DEMO_CALL_RECIPIENT=
