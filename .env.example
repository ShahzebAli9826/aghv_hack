# ========================================================
# AEGIS FLOOD DETECTION & RESPONSE SYSTEM - ENVIRONMENT CONFIG
# (Template file: Duplicate this to .env and fill in your keys)
# ========================================================

# --- Sentinel Hub Satellite API Credentials ---
SENTINEL_CLIENT_ID=your_sentinel_client_id_here
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret_here

# --- OpenWeatherMap API ---
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- Twilio (SMS & Voice IVR Alerts) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# --- SMTP Email Notifications ---
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_SENDER_PASSWORD=your_google_app_password_here
ALERT_RECIPIENT_EMAIL=alerts@example.com

# --- LLM & AI Reasoning API Keys ---
GEMINI_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Mapbox Geospatial Token ---
MAPBOX_TOKEN=your_mapbox_public_token_here

# --- Central Water Commission River Gauge API ---
CWC_API_KEY=your_cwc_api_key_here

# --- Machine Learning Weights Configuration ---
MODEL_WEIGHTS_PATH=app/ml/weights/mit_b2_segformer.onnx
MODEL_CONFIDENCE_THRESHOLD=0.5

# --- Database & Storage Configuration ---
DATABASE_URL=sqlite:///./flood_database.db
CHROMA_DB_PATH=./chroma_data

# --- Authentication & Security ---
JWT_SECRET_KEY=your_custom_jwt_secret_key_here

# ========================================================
# AWS CLOUD INTEGRATION (100% FREE TIER)
# ========================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=ap-south-1

# 1. Amazon S3 (SITREP PDFs & 4D Nowcast Heatmaps)
AWS_S3_BUCKET=aegis-disaster-vault

# 2. Amazon DynamoDB (Citizen Ground Reports & Shelters)
AWS_DYNAMODB_REPORTS_TABLE=Aegis-Citizen-Reports
AWS_DYNAMODB_SHELTERS_TABLE=Aegis-Emergency-Shelters

# 3. Amazon SNS (Mass Emergency Broadcast)
AWS_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:Aegis-Flash-Flood-Alerts

# 4. Amazon Cognito (Role-Based OIDC/JWT Auth)
AWS_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
AWS_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# 5. Amazon CloudWatch (Live Telemetry Namespace)
AWS_CLOUDWATCH_NAMESPACE=Aegis/DisasterResponse

# 6. Amazon CloudFront (Web CDN Distribution Domain)
AWS_CLOUDFRONT_DOMAIN=https://d2aegis-flood-portal.cloudfront.net

# 7. Amazon Bedrock Runtime & Knowledge Bases
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_BEDROCK_KB_ID=KB-AEGIS-NDMA-SOP-2026

# 8. Amazon Location Service (Place Index, Route Calculator & Geofences)
AWS_LOCATION_PLACE_INDEX=Aegis-India-PlaceIndex
AWS_LOCATION_ROUTE_CALC=Aegis-Evacuation-RouteCalculator
AWS_LOCATION_GEOFENCE_COLLECTION=Aegis-Flood-Hazard-Geofences

# 9. Amazon EventBridge & AWS Step Functions
AWS_EVENTBRIDGE_BUS=aegis-disaster-event-bus
AWS_STEP_FUNCTIONS_ARN=arn:aws:states:ap-south-1:000000000000:stateMachine:Aegis-6Agent-Incident-Workflow

# 10. Amazon SQS FIFO Queue & DynamoDB MCP Audit Table
AWS_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/000000000000/Aegis-SOS-Triage-Queue.fifo
AWS_DYNAMODB_MCP_AUDIT_TABLE=Aegis-MCP-Audit-Ledger

