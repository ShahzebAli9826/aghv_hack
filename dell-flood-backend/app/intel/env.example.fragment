# --- TinyFish live flood intelligence (app/intel) ---
# Mode: live | replay | disabled. Default: live when TINYFISH_API_KEY is set and TINYFISH_ENABLED is not false.
# replay serves app/intel/fixtures/*.json and marks every item mock.
TINYFISH_MODE=
TINYFISH_ENABLED=false
TINYFISH_API_KEY=
TINYFISH_AGENT_BASE_URL=https://agent.tinyfish.ai
TINYFISH_MAX_CONCURRENT_AGENT_RUNS=2
TINYFISH_USD_PER_STEP=0.016
TINYFISH_MAX_USD_PER_REQUEST=0.50
TINYFISH_MAX_STEPS_PER_RUN=30
TINYFISH_RUN_TIMEOUT_S=180
TINYFISH_POLL_INTERVAL_S=3
TINYFISH_ALLOW_UNVERIFIED_SOURCES=false
# Shared secret checked on POST /api/agent/web-intelligence/webhook?token=...
TINYFISH_WEBHOOK_TOKEN=
# Public HTTPS base URL of this backend; webhook_url is sent to TinyFish only when this and the token are set.
TINYFISH_PUBLIC_BASE_URL=
# IMD API key (api.imd.gov.in). Without it, IMD warnings use the labelled Fetch fallback.
IMD_API_KEY=
# Optional override of the SQLite file (defaults to dell-flood-backend/flood_app.db, shared with the orchestrator).
AEGIS_APP_DB=
