# Auth. Leave the secrets empty and each process signs tokens with a random secret (tokens die on restart).
# More than one worker (WEB_CONCURRENCY>1 or uvicorn --workers N) needs an explicit JWT_SECRET_KEY shared by all
# workers; startup fails without it. AWS_COGNITO_FALLBACK_SECRET defaults to JWT_SECRET_KEY when empty.
# STRICT_AUTH=false re-enables the anonymous demo-official fallback; never use it with real credentials.
JWT_SECRET_KEY=
AWS_COGNITO_FALLBACK_SECRET=
STRICT_AUTH=true
# Comma-separated browser origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://127.0.0.1:8081

# Sentinel Hub API Credentials
SENTINEL_CLIENT_ID=your_sentinel_client_id
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret

# OpenWeatherMap API Key
OPENWEATHER_API_KEY=your_openweather_api_key

# Twilio Credentials (Unified for SMS & IVR)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# SendGrid Email Credentials
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=your_verified_from_email

# Optional Exotel Credentials (Fallback IVR)
EXOTEL_SID=your_exotel_sid
EXOTEL_TOKEN=your_exotel_token

# RAG & Agent Reasoning API Keys (Configure at least one)
GEMINI_API_KEY=your_google_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Mapbox Token (Required for Geocoding & Map renders)
MAPBOX_TOKEN=your_mapbox_public_token

# Central Water Commission River Gauge API Key
CWC_API_KEY=your_cwc_api_key

# Machine Learning Model Configuration
MODEL_WEIGHTS_PATH=app/ml/weights/mit_b2_segformer.onnx
MODEL_CONFIDENCE_THRESHOLD=0.5

# Database Config
DATABASE_URL=sqlite:///./flood_database.db
CHROMA_DB_PATH=./chroma_data

# ========================================================
# AWS CLOUD INTEGRATION (100% FREE TIER)
# ========================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=ap-south-1

# 1. Amazon S3 (SITREP PDFs & 4D Nowcast Heatmaps)
AWS_S3_BUCKET=aegis-disaster-vault

# 2. Amazon DynamoDB (Citizen Ground Reports & Shelters)
AWS_DYNAMODB_REPORTS_TABLE=Aegis-Citizen-Reports
AWS_DYNAMODB_SHELTERS_TABLE=Aegis-Emergency-Shelters

# 3. Amazon SNS (Mass Emergency Broadcast)
AWS_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:Aegis-Flash-Flood-Alerts

# 4. Amazon Cognito (Role-Based OIDC/JWT Auth)
AWS_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
AWS_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# 5. Amazon CloudWatch (Live Telemetry Namespace)
AWS_CLOUDWATCH_NAMESPACE=Aegis/DisasterResponse

# 6. Amazon CloudFront (Web CDN Distribution Domain)
AWS_CLOUDFRONT_DOMAIN=https://d2aegis-flood-portal.cloudfront.net

# --- TinyFish live flood intelligence (app/intel) ---
# Mode: live | replay | disabled. Default: live when TINYFISH_API_KEY is set and TINYFISH_ENABLED is not false.
# replay serves app/intel/fixtures/*.json and marks every item mock.
TINYFISH_MODE=
TINYFISH_ENABLED=false
TINYFISH_API_KEY=
TINYFISH_AGENT_BASE_URL=https://agent.tinyfish.ai
TINYFISH_MAX_CONCURRENT_AGENT_RUNS=2
TINYFISH_USD_PER_STEP=0.016
TINYFISH_MAX_USD_PER_REQUEST=0.50
TINYFISH_MAX_STEPS_PER_RUN=30
TINYFISH_RUN_TIMEOUT_S=180
TINYFISH_POLL_INTERVAL_S=3
TINYFISH_ALLOW_UNVERIFIED_SOURCES=false
# Shared secret checked on POST /api/agent/web-intelligence/webhook?token=...
TINYFISH_WEBHOOK_TOKEN=
# Public HTTPS base URL of this backend; webhook_url is sent to TinyFish only when this and the token are set.
TINYFISH_PUBLIC_BASE_URL=
# IMD API key (api.imd.gov.in). Without it, IMD warnings use the labelled Fetch fallback.
IMD_API_KEY=
# Optional override of the SQLite file (defaults to dell-flood-backend/flood_app.db, shared with the orchestrator).
AEGIS_APP_DB=
